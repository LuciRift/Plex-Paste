                </div>
              </div>
            </div>

<div class="form-group">
  <div class="form-grid">
    <div class="form-group">
      <label class="form-label">
        <i class="fas fa-heading"></i>
        SEO Title
      </label>
      <input class="form-input" type="text" x-model="settings.seoTitle" name="seoTitle" placeholder="Plex Paste - Modern Code & Text Sharing" maxlength="60">
      <div class="form-help">
        <i class="fas fa-info-circle"></i>
        Title tag for search engines (recommended: 50-60 characters)
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <i class="fas fa-align-left"></i>
