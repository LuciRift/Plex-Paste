      </label>
      <textarea class="form-textarea" x-model="settings.seoDescription" name="seoDescription" rows="3" placeholder="A modern, secure paste service for sharing code and text with syntax highlighting, password protection, and API access." maxlength="160"></textarea>
      <div class="form-help">
        <i class="fas fa-info-circle"></i>
        Meta description for search engines (recommended: 150-160 characters)
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">
        <i class="fas fa-tags"></i>
        SEO Keywords
      </label>
      <input class="form-input" type="text" x-model="settings.seoKeywords" name="seoKeywords" placeholder="paste, code sharing, text sharing, pastebin, syntax highlighting, secure">
      <div class="form-help">
        <i class="fas fa-info-circle"></i>
        Comma-separated keywords for search engines (optional, use sparingly)
      </div>
    </div>
  </div>
</div>

            <div class="action-buttons">
              <button type="submit" class="btn btn-primary" :disabled="saving">
                <i class="fas fa-save"></i>
                <span x-text="saving ? 'Saving...' : 'Save Changes'"></span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <div x-show="currentTab === 'security'" class="section-card">
        <div class="section-header">
          <div class="section-title">
            <i class="fas fa-shield-alt"></i>
            Security & Rate Limiting
          </div>
          <div class="section-description">Configure security measures and rate limiting</div>
        </div>
        <div class="section-content">
          <form @submit.prevent="saveSettings('security')" class="form-grid">
            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-clock"></i>
                Web Rate Limiting
              </label>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-hashtag"></i>
                    Max Requests
                  </label>
                  <input class="form-input" type="number" x-model="settings.rateLimit" min="1" max="10000" placeholder="50">
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Maximum number of paste creation requests
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-stopwatch"></i>
                    Time Window
                  </label>
                  <select class="form-select" x-model="settings.rateLimitWindow">
                    <option value="1m">Per Minute</option>
                    <option value="5m">Per 5 Minutes</option>
                    <option value="15m">Per 15 Minutes</option>
                    <option value="30m">Per 30 Minutes</option>
                    <option value="1h">Per Hour</option>
                    <option value="6h">Per 6 Hours</option>
                    <option value="12h">Per 12 Hours</option>
                    <option value="1d">Per Day</option>
                  </select>
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Time period for rate limit reset
                  </div>
                </div>
              </div>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Limit how many pastes a single IP address can create & view within the specified time window.
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-file-alt"></i>
                Max Paste Size (MB)
              </label>
              <input class="form-input" type="number" x-model="settings.maxPasteSize" min="0.1" max="50" step="0.1" placeholder="10">
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Maximum file size allowed for individual pastes. Larger files consume more storage and bandwidth.
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-code"></i>
                API Access
              </label>
              <div class="toggle-group">
                <label class="toggle-switch">
                  <input type="checkbox" :checked="settings.enableAPI" @change="settings.enableAPI = $event.target.checked">
                  <span class="toggle-slider"></span>
                </label>
                <span>Enable API for paste creation</span>
              </div>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Allow users to create pastes via API requests (POST). Useful for integrations with text editors, CLI tools, and automation scripts.
              </div>
            </div>

            <div class="form-group" x-show="settings.enableAPI">
              <label class="form-label">
                <i class="fas fa-key"></i>
                API Rate Limiting
              </label>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-hashtag"></i>
                    Max API Requests
                  </label>
                  <input class="form-input" type="number" x-model="settings.apiRateLimit" min="10" max="100000" placeholder="500">
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Maximum API requests allowed
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-stopwatch"></i>
                    API Time Window
                  </label>
                  <select class="form-select" x-model="settings.apiRateLimitWindow">
                    <option value="1m">Per Minute</option>
                    <option value="5m">Per 5 Minutes</option>
                    <option value="15m">Per 15 Minutes</option>
                    <option value="30m">Per 30 Minutes</option>
                    <option value="1h">Per Hour</option>
                    <option value="6h">Per 6 Hours</option>
                    <option value="12h">Per 12 Hours</option>
                    <option value="1d">Per Day</option>
                  </select>
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Time period for API rate limit reset
                  </div>
                </div>
              </div>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Separate rate limiting specifically for API requests. Generally higher than web limits since APIs are used for automation.
              </div>
            </div>

            <div class="form-group" x-show="settings.enableAPI">
              <label class="form-label">
                <i class="fas fa-lock"></i>
                API Key Protection
              </label>
              <div class="toggle-group">
                <label class="toggle-switch">
                  <input type="checkbox" :checked="settings.requireApiKey" @change="settings.requireApiKey = $event.target.checked">
                  <span class="toggle-slider"></span>
                </label>
                <span>Require API key for all API requests</span>
              </div>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                When enabled, all API requests must include a valid API key for authorization.
              </div>
            </div>

            <div class="form-group" x-show="settings.enableAPI && settings.requireApiKey">
              <label class="form-label">
                <i class="fas fa-key"></i>
                Master API Key
              </label>
              <input class="form-input" type="text" x-model="settings.apiKey" placeholder="Enter your API key">
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Set the master API key for your application. This key will be required for all API requests. Use only alphanumeric characters and underscores.
              </div>
            </div>

            <!-- Add this button after the API Key field in the security section -->
            <div class="form-group" x-show="settings.enableAPI">
              <button type="button" class="btn btn-warning" @click="showApiGuide = !showApiGuide">
                <i class="fas fa-book"></i>
                <span x-text="showApiGuide ? 'Hide API Usage Guide' : 'Show API Usage Guide'"></span>
              </button>
            </div>

            <!-- Add this expandable section after the API button -->
            <div x-show="settings.enableAPI && showApiGuide" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translateY(-10px)" x-transition:enter-end="opacity-100 transform translateY(0)" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 transform translateY(0)" x-transition:leave-end="opacity-0 transform translateY(-10px)" class="api-guide-section">

              <div class="section-card" style="margin-top: 1.5rem;">
                <div class="section-header">
                  <div class="section-title">
                    <i class="fas fa-code"></i>
                    API Usage Guide
                  </div>
                  <div class="section-description">Learn how to integrate with the Paste API</div>
                </div>

                <div class="section-content">
                  <div class="form-grid">

                    <!-- API Endpoint -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-link"></i>
                        API Endpoint
                      </label>
                      <div class="api-endpoint-box">
                        <code>POST <span x-text="window.location.origin"></span>/documents</code>
                      </div>
                    </div>

                    <!-- Authentication -->
                    <div class="form-group" x-show="settings.requireApiKey">
                      <label class="form-label">
                        <i class="fas fa-key"></i>
                        Authentication
                      </label>
                      <div class="api-info-box">
                        Include your API key in the request headers:
                        <br><br>
                        <code>X-API-Key: YOUR_API_KEY</code>
                        <br><br>
                        Or as a query parameter:
                        <br><br>
                        <code>?apiKey=YOUR_API_KEY</code>
                      </div>
                    </div>

                    <!-- Request Body -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-file-code"></i>
                        Request Body Options
                      </label>
                      <div class="api-options-grid">
                        <div class="api-option">
                          <strong>Plain Text:</strong>
                          <div class="api-code-block">
                            <code>Content-Type: text/plain</code>
                            <pre>Your paste content here...</pre>
                          </div>
                        </div>

                        <div class="api-option">
                          <strong>JSON Object:</strong>
                          <div class="api-code-block">
                            <code>Content-Type: application/json</code>
                            <pre>{
  "content": "Your paste content",
  "password": "optional_password",
  "maxViews": 10
}</pre>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- JavaScript Example -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fab fa-js-square"></i>
                        JavaScript Example
                      </label>
                      <div class="api-code-example">
                        <pre><code>// Simple text paste
const response = await fetch('<span x-text="window.location.origin"></span>/documents', {
  method: 'POST',<span x-show="settings.requireApiKey">
  headers: {
    'X-API-Key': 'YOUR_API_KEY',
    'Content-Type': 'text/plain'
  },</span><span x-show="!settings.requireApiKey">
  headers: {
    'Content-Type': 'text/plain'
  },</span>
  body: 'Your paste content here'
});

const result = await response.json();
console.log('Paste URL:', result.url);

// Advanced paste with options
const advancedResponse = await fetch('<span x-text="window.location.origin"></span>/documents', {
  method: 'POST',<span x-show="settings.requireApiKey">
  headers: {
    'X-API-Key': 'YOUR_API_KEY',
    'Content-Type': 'application/json'
  },</span><span x-show="!settings.requireApiKey">
  headers: {
    'Content-Type': 'application/json'
  },</span>
  body: JSON.stringify({
    content: 'Your paste content',
    password: 'secret123',      // Optional
    maxViews: 5                 // Optional
  })
});

const advancedResult = await advancedResponse.json();
console.log('Protected paste:', advancedResult);</code></pre>
                      </div>
                    </div>

                    <!-- cURL Example -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-terminal"></i>
                        cURL Example
                      </label>
                      <div class="api-code-example">
                        <pre><code># Simple paste
curl -X POST <span x-text="window.location.origin"></span>/documents \<span x-show="settings.requireApiKey">
  -H "X-API-Key: YOUR_API_KEY" \</span>
  -H "Content-Type: text/plain" \
  -d "Your paste content"

# Advanced paste with JSON
curl -X POST <span x-text="window.location.origin"></span>/documents \<span x-show="settings.requireApiKey">
  -H "X-API-Key: YOUR_API_KEY" \</span>
  -H "Content-Type: application/json" \
  -d '{
    "content": "Your paste content",
    "password": "secret123",
    "maxViews": 10
  }'</code></pre>
                      </div>
                    </div>

                    <!-- Response Format -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-arrow-left"></i>
                        Response Format
                      </label>
                      <div class="api-code-example">
                        <pre><code>{
  "key": "abc123def",
  "url": "<span x-text="window.location.origin"></span>/abc123def",
  "password_protected": true,  // Only if password was set
  "max_views": 10             // Only if maxViews was set
}</code></pre>
                      </div>
                    </div>

                    <!-- Rate Limits -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-tachometer-alt"></i>
                        Rate Limits
                      </label>
                      <div class="api-info-box">
                        <strong>Current API Rate Limit:</strong>
                        <br>
                        <span x-text="settings.apiRateLimit"></span> requests per <span x-text="settings.apiRateLimitWindow.replace('m', ' minute').replace('h', ' hour').replace('d', ' day')"></span>
                        <br><br>
                        Rate limits are applied per IP address. Exceeded limits will return HTTP 429.
                      </div>
                    </div>

                    <!-- Error Codes -->
                    <!-- Replace the existing error codes section with this -->
                    <div class="form-group">
                      <label class="form-label">
                        <i class="fas fa-exclamation-triangle"></i>
                        Error Response Messages
                      </label>
                      <div class="api-error-table">
                        <div class="error-row">
                          <span class="error-code">400</span>
                          <span class="error-desc">NO_CONTENT - Request body is missing or invalid</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">400</span>
                          <span class="error-desc">CONTENT_REQUIRED - Content is empty or only whitespace</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">400</span>
                          <span class="error-desc">CONTENT_TOO_LARGE - Content exceeds maximum size limit</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">400</span>
                          <span class="error-desc">INVALID_MAX_VIEWS - maxViews must be a positive integer</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">400</span>
                          <span class="error-desc">INVALID_PASSWORD_FORMAT - Password must be a string</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">401</span>
                          <span class="error-desc">Valid API key required - Missing or invalid API key</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">403</span>
                          <span class="error-desc">API_DISABLED - API access is currently disabled</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">429</span>
                          <span class="error-desc">Rate limit exceeded - Too many requests, try again later</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">500</span>
                          <span class="error-desc">SLUG_GENERATION_FAILED - Failed to generate unique URL</span>
                        </div>
                        <div class="error-row">
                          <span class="error-code">500</span>
                          <span class="error-desc">INTERNAL_ERROR - Server error occurred</span>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>

            <div class="action-buttons">
              <button type="submit" class="btn btn-primary" :disabled="saving">
                <i class="fas fa-save"></i>
                <span x-text="saving ? 'Saving...' : 'Save Security Settings'"></span>
              </button>
            </div>
          </form>
        </div>
      </div>


      <div x-show="currentTab === 'advanced'" class="section-card">
        <div class="section-header">
          <div class="section-title">
            <i class="fas fa-wrench"></i>
            Advanced Configuration
          </div>
          <div class="section-description">Advanced settings for paste expiration, syntax highlighting, and URL generation</div>
        </div>
        <div class="section-content">
          <form @submit.prevent="saveSettings('advanced')" class="form-grid">
            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-trash-alt"></i>
                Inactive Paste Auto-Delete
              </label>
              <select class="form-select" x-model="settings.inactiveDeleteAfter">
                <option value="never">Never delete inactive pastes</option>
                <option value="30d">Delete after 30 days of inactivity</option>
                <option value="90d">Delete after 90 days of inactivity</option>
                <option value="6m">Delete after 6 months of inactivity</option>
                <option value="1y">Delete after 1 year of inactivity</option>
                <option value="2y">Delete after 2 years of inactivity</option>
              </select>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Automatically delete pastes that haven't been viewed in the specified time period. Helps manage storage space and removes unused content. "Inactive" means the paste hasn't been accessed or viewed.
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-code"></i>
                Syntax Highlighting
              </label>
              <div class="toggle-group">
                <label class="toggle-switch">
                  <input type="checkbox" :checked="settings.enableSyntaxHighlighting" @change="settings.enableSyntaxHighlighting = $event.target.checked">
                  <span class="toggle-slider"></span>
                </label>
                <span>Enable syntax highlighting for code</span>
              </div>
              <div class="form-help">
                <i class="fas fa-info-circle"></i>
                Automatically detect programming languages and apply syntax highlighting to make code more readable. Improves user experience for developers.
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                <i class="fas fa-link"></i>
                URL Slug Configuration
              </label>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-ruler"></i>
                    Slug Length
                  </label>
                  <input type="number" class="form-input" x-model="settings.slugLength" min="4" max="20" placeholder="8">
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Length of the random URL identifier (4-20 characters)
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">
                    <i class="fas fa-font"></i>
                    Character Set
                  </label>
                  <select class="form-select" x-model="settings.slugCharacterSet">
                    <option value="alphanumeric">Letters and Numbers (a-z, A-Z, 0-9)</option>
                    <option value="lowercase">Lowercase Only (a-z, 0-9)</option>
                    <option value="numbers">Numbers Only (0-9)</option>
                    <option value="letters">Letters Only (a-z, A-Z)</option>
                    <option value="hex">Hexadecimal (0-9, a-f)</option>
                  </select>
                  <div class="form-help">
                    <i class="fas fa-info-circle"></i>
                    Character types used in paste URLs
                  </div>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">
                  <i class="fas fa-eye"></i>
                  Preview Format
                </label>
                <div class="form-input" style="background: var(--bg-secondary); font-family: 'Source Code Pro', monospace;">
                  <span x-text="generateSlugPreview()"></span>
                </div>
                <div class="form-help">
                  <i class="fas fa-info-circle"></i>
                  Example of how paste URLs will look with current settings
                </div>
              </div>
            </div>

            <div class="action-buttons">
              <button type="submit" class="btn btn-primary" :disabled="saving">
                <i class="fas fa-save"></i>
                <span x-text="saving ? 'Saving...' : 'Save Advanced Settings'"></span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div x-show="notification.message" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 transform translateX(-50%) translateY(-100px)" x-transition:enter-end="opacity-100 transform translateX(-50%) translateY(0)" x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100 transform translateX(-50%) translateY(0)" x-transition:leave-end="opacity-0 transform translateX(-50%) translateY(-100px)" :class="['notification', 'show', notification.type]" x-cloak x-text="notification.message">
    </div>

    <script>
      function staffPanel() {
        return {
          currentTab: 'overview',
          saving: false,
          showApiGuide: false,
          notification: {
            show: false,
            type: '',
            message: ''
          },
          stats: {
            totalPastes: 0,
            totalViews: 0,
            pastesLast30Days: 0,
            apiPastes: 0,
            storage: '0MB',
            averageViews: 0,
            topPasteViews: 0,
            averageSize: '0KB'
          },
settings: {
    name: '<%= settings?.name || "" %>',
    accentColor: '<%= settings?.accentColor || "#00d4ff" %>',
    seoTitle: '<%= settings?.seoTitle || "" %>',
    seoDescription: '<%= settings?.seoDescription || "" %>',
    seoKeywords: '<%= settings?.seoKeywords || "" %>',
    rateLimit: <%= settings?.rateLimit || 50 %>,
    rateLimitWindow: '<%= settings?.rateLimitWindow || "1h" %>',
    maxPasteSize: <%= settings?.maxPasteSize || 10 %>,
    enableAPI: <%= settings?.enableAPI ? 'true' : 'false' %>,
    apiRateLimit: <%= settings?.apiRateLimit || 500 %>,
    apiRateLimitWindow: '<%= settings?.apiRateLimitWindow || "1h" %>',
    requireApiKey: <%= settings?.requireApiKey ? 'true' : 'false' %>,
    apiKey: '<%= settings?.apiKey || "" %>',
    inactiveDeleteAfter: '<%= settings?.inactiveDeleteAfter || "never" %>',
    enableSyntaxHighlighting: <%= settings?.enableSyntaxHighlighting ? 'true' : 'false' %>,
    slugLength: <%= settings?.slugLength || 8 %>,
    slugCharacterSet: '<%= settings?.slugCharacterSet || "alphanumeric" %>'
},

          init() {
            this.loadStats();
            this.initializeTab();
          },

          initializeTab() {
            const urlParams = new URLSearchParams(window.location.search);
            const tab = urlParams.get('tab');
            if (tab && ['overview', 'general', 'security', 'advanced'].includes(tab)) {
              this.currentTab = tab;
            }
          },

          switchTab(tab) {
            this.currentTab = tab;
            const url = new URL(window.location);
            url.searchParams.set('tab', tab);
            window.history.replaceState({}, '', url);
          },

          async loadStats() {
            try {
              const response = await fetch('/api/stats');
              if (response.ok) {
                const data = await response.json();

                this.stats = {
                  totalPastes: this.formatNumber(data.totalPastes || 0),
                  totalViews: this.formatNumber(data.totalViews || 0),
                  pastesLast30Days: this.formatNumber(data.pastesLast30Days || 0),
                  apiPastes: this.formatNumber(data.apiPastes || 0),
                  storage: data.storage || '0MB',
                  averageViews: parseFloat(data.averageViews || 0).toFixed(1),
                  topPasteViews: this.formatNumber(data.topPasteViews || 0),
                  averageSize: data.averageSize || '0KB'
                };

              } else {
                console.error('Failed to load stats:', response.status);
                this.showNotification('Failed to load statistics', 'error');
              }
            } catch (error) {
              console.error('Error loading stats:', error);
              this.showNotification('Error loading statistics', 'error');
            }
          },

          formatNumber(num) {
            const absNum = Math.abs(num);

            if (absNum >= 1e12) {
              return (num / 1e12).toFixed(1) + 'T';
            } else if (absNum >= 1e9) {
              return (num / 1e9).toFixed(1) + 'B';
            } else if (absNum >= 1e6) {
              return (num / 1e6).toFixed(1) + 'M';
            } else if (absNum >= 1e3) {
              return (num / 1e3).toFixed(1) + 'K';
            }
            return num.toLocaleString();
          },

          async saveGeneralSettings(event) {
            this.saving = true;

            try {
              const formData = new FormData(event.target);

              const response = await fetch('/staff/settings', {
                method: 'POST',
                body: formData
              });

              if (response.ok) {
                this.showNotification('Settings saved successfully!', 'success');
                setTimeout(() => {
                  window.location.reload();
                }, 1500);
              } else {
                this.showNotification('Failed to save settings.', 'error');
                this.saving = false;
              }
            } catch (error) {
              console.error('Error saving settings:', error);
              this.showNotification('Network error occurred.', 'error');
              this.saving = false;
            }
          },

          async saveSettings(section) {
            this.saving = true;

            try {
              const response = await fetch('/staff/settings', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                  section,
                  settings: this.settings
                })
              });

              if (response.ok) {
                this.showNotification('Settings saved successfully!', 'success');
                setTimeout(() => {
                  window.location.reload();
                }, 1500);
              } else {
                this.showNotification('Failed to save settings.', 'error');
                this.saving = false;
              }
            } catch (error) {
              console.error('Error saving settings:', error);
              this.showNotification('Network error occurred.', 'error');
              this.saving = false;
            }
          },

          async clearAllPastes() {
            if (!confirm('Are you sure you want to delete ALL pastes? This action cannot be undone!')) {
              return;
            }

            try {
              const response = await fetch('/staff/clear-all-pastes', {
                method: 'DELETE'
              });

              if (response.ok) {
                this.showNotification('All pastes have been deleted.', 'success');
                setTimeout(() => {
                  this.loadStats();
                }, 1000);
              } else {
                this.showNotification('Failed to clear pastes.', 'error');
              }
            } catch (error) {
              console.error('Error clearing pastes:', error);
              this.showNotification('Network error occurred.', 'error');
            }
          },

          showNotification(message, type) {
            this.notification = {
              message,
              type
            };
            setTimeout(() => {
              this.notification = {
                message: '',
                type: ''
              };
            }, 4000);
          },

          formatDate(dateString) {
            return new Date(dateString).toLocaleDateString('en-US', {
              month: 'short',
              day: 'numeric',
              hour: '2-digit',
              minute: '2-digit'
            });
          },

          generateSlugPreview() {
            const sets = {
              'alphanumeric': 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789',
              'lowercase': 'abcdefghijklmnopqrstuvwxyz0123456789',
              'numbers': '0123456789',
              'letters': 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ',
              'hex': '0123456789abcdef'
            };

            const chars = sets[this.settings.slugCharacterSet] || sets.alphanumeric;
            const length = parseInt(this.settings.slugLength) || 8;

            let result = '';
            for (let i = 0; i < length; i++) {
              result += chars.charAt(Math.floor(Math.random() * chars.length));
            }

            return `${window.location.origin}/${result}`;
          }
        }
      }
      document.addEventListener('alpine:init', () => {
        setTimeout(() => {
          document.getElementById('loadingScreen').style.display = 'none';
          document.body.classList.add('alpine-loaded');
        }, 400);
      });
    </script>
</body>

</html>